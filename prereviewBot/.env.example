# Discord bot token. Required.
DISCORD_TOKEN=

# Optional: register slash commands instantly to a single guild during development.
# Leave empty to register globally (can take up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Optional: override the per-check timeout in seconds. Default: 120.
REVIEW_CHECK_TIMEOUT_SECONDS=

# Optional: override the total per-review timeout in seconds. Default: 600.
REVIEW_TOTAL_TIMEOUT_SECONDS=
